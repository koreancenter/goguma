    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@uiw/react-codemirror": "^4.25.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "express": "^4.21.2",
    "js-beautify": "^1.15.4",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
